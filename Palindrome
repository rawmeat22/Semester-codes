
#include <iostream>
using namespace std;

int main()
{
    int n, rev = 0, rem, temp;

    cout << "Enter a number: ";
    cin >> n;

    temp = n;

    while (n > 0)
    {
        rem = n % 10;
        rev = rev * 10 + rem;
        n = n / 10;
    }

    if (temp == rev)
        cout << "Number is Palindrome";
    else
        cout << "Number is Not Palindrome";

    return 0;
}
Enter a number: 121
Number is Palindrome




#include <iostream>
#include <string>
using namespace std;

int main()
{
    string str, rev = "";

    cout << "Enter a string: ";
    cin >> str;

    for (int i = str.length() - 1; i >= 0; i--)
    {
        rev = rev + str[i];
    }

    if (str == rev)
        cout << "String is Palindrome";
    else
        cout << "String is Not Palindrome";

    return 0;
}
Enter a string: madam
String is Palindrome


